# dependencies
node_modules/
.pnp
.pnp.js

# next.js build output
.next/
out/
build/

# production
coverage/
*.tsbuildinfo

# local env files (never commit secrets)
.env
.env.local
.env.*.local
# any other env variant (.env.production, .env.development, ...) may carry real
# secrets, so ignore them all; only the public placeholder template stays tracked.
.env.*
!.env.example

# sqlite database + WAL side files
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# dev server runtime artifacts (produced by scripts/start-dev.ps1)
.dev-server.pid
.dev-server.port
.dev-logs/

# local scratch copies of the tree (throwaway analysis/verification workspaces that
# some tooling drops next to the real sources; they duplicate src/ and tests/ and
# must never be committed)
%MUT%/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
